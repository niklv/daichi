{
  "name": "daichi",
  "version": "2.0.1",
  "description": "Comfort cloud API wrapper to control HVAC",
  "keywords": [
    "daichi",
    "daikin",
    "hvac"
  ],
  "homepage": "https://github.com/niklv/daichi",
  "bugs": "https://github.com/niklv/daichi/issues",
  "license": "MIT",
  "author": {
    "name": "Nikita Lvov",
    "email": "niklvov@gmail.com",
    "url": "https://github.com/niklv"
  },
  "repository": {
    "url": "git+https://github.com/niklv/daichi.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live --reporter=verbose"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "debug": "^4.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
